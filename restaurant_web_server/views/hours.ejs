<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <title>Restaurant</title>
  <link rel="stylesheet" href="public/stylesheets/style.css" />
</head>

<body>
  <h1>Our Hours</h1>
  <div class="hours-container">
    <% for(let day of days) { %>
      <% const hoursObj=operatingHours[day] || operatingHours['defaultHours'] %>
        <section class="<%= day === today ? 'today' : '' %>">
          <h2>
            <%= day.toUpperCase() %>
          </h2>
          <div>
            <% if (hoursObj.open) {%>
              <p><strong>Open:</strong>
                <%= hoursObj.open %>
              </p>
              <p><strong>Closed:</strong>
                <%= hoursObj.closed %>
              </p>
              <% } else {%>
                <p><strong>CLOSED</strong></p>
                <% } %>
          </div>
        </section>
        <% }%>
  </div>
</body>

</html>